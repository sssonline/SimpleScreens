<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-include="false">

    <transition name="createNetworkPrinter"><service-call name="create#moqui.basic.print.NetworkPrinter"/>
        <default-response url="."/></transition>
    <transition name="updateNetworkPrinter"><service-call name="update#moqui.basic.print.NetworkPrinter"/>
        <default-response url="."/></transition>
    <transition name="deleteNetworkPrinter"><service-call name="delete#moqui.basic.print.NetworkPrinter"/>
        <default-response url="."/></transition>
    <transition name="printJobList"><default-response url="../../PrintJob/PrintJobList"/></transition>

<!--    <transition name="startPrinter">-->
<!--        <service-call name="sssonline.basalt.PrintServices.start#Printer" in-map="[networkPrinterId:networkPrinterId,activeOrgId:activeOrgId]"/>-->
<!--        <default-response url="."/>-->
<!--    </transition>-->

<!--    <transition name="pausePrinter">-->
<!--        <service-call name="sssonline.basalt.PrintServices.pause#Printer" in-map="[networkPrinterId:networkPrinterId,activeOrgId:activeOrgId]"/>-->
<!--        <default-response url="."/>-->
<!--    </transition>-->

    <actions>
        <set field="activeOrgId" from="ec.user.getPreference('ACTIVE_ORGANIZATION')"/>
        <entity-find entity-name="moqui.basic.print.NetworkPrinter" list="networkPrinterList">
            <search-form-inputs default-order-by="serverHost,printerName"/>
        </entity-find>
<!--        <service-call name="sssonline.basalt.PrintServices.get#PrintSettings" in-map="[activeOrgId:activeOrgId]" out-map="printSettings"/>-->
    </actions>
    <widgets>
        <container-dialog id="CreateDialog" button-text="Create Printer">
            <form-single name="CreateForm" transition="createNetworkPrinter">
                <field name="serverHost"><default-field><text-line size="40"/></default-field></field>
                <field name="serverPort"><default-field><text-line size="5" default-value="631"/></default-field></field>
                <field name="printerName"><default-field tooltip="Must match name on server exactly">
                    <text-line size="40"/></default-field></field>
                <field name="outputQueueLibrary">
                    <default-field>
                        <text-line size="15"/>
                    </default-field>
                </field>
                <field name="description"><default-field><text-line size="40"/></default-field></field>
                <field name="location"><default-field><text-line size="40"/></default-field></field>
                <field name="submitButton"><default-field title="Create Printer"><submit/></default-field></field>
            </form-single>
        </container-dialog>
        <form-list name="PrintJobList" list="networkPrinterList">
            <row-actions>
                <service-call name="sssonline.basalt.PrintServices.get#PrinterIpAddress"
                              in-map="[networkPrinterId:networkPrinterId,activeOrgId:activeOrgId]"
                              out-map="printerIpInfo"/>
                <service-call name="sssonline.basalt.PrintServices.get#PrinterStatus"
                              in-map="[networkPrinterId:networkPrinterId,activeOrgId:activeOrgId]"
                              out-map="printerStatusInfo"/>
            </row-actions>
            <field name="printerName">
<!--                <header-field show-order-by="true"><text-find size="15" hide-options="true"/></header-field>-->
                <default-field title="OutQueue">
<!--                    <display/>-->
                    <link url="../PrinterDetail" text="${printerName}" parameter-map="[networkPrinterId:networkPrinterId]"/>
                </default-field>
            </field>
            <field name="ipAddress" from="printerIpInfo?.printerIpAddress">
                <default-field>
                    <display/>
                </default-field>
            </field>
            <field name="description">
                <default-field>
                    <display/>
                </default-field>
            </field>
            <field name="printerStatus" from="printerStatusInfo?.printerStatus">
                <default-field>
                    <display/>
                </default-field>
            </field>
<!--            <field name="actions">-->
<!--                <default-field>-->
<!--                    <link url="startPrinter" text="Start" parameter-map="[networkPrinterId:networkPrinterId,activeOrgId:activeOrgId]"/>-->
<!--                    <link url="pausePrinter" text="Pause" parameter-map="[networkPrinterId:networkPrinterId,activeOrgId:activeOrgId]"/>-->
<!--                </default-field>-->
<!--            </field>-->
            <field name="jobs"><default-field>
                <link url="printJobList" text="Jobs" parameter-map="[networkPrinterId:networkPrinterId]"/>
            </default-field></field>
<!--            <field name="printerName">-->
<!--                <header-field show-order-by="true"><text-find size="15" hide-options="true"/></header-field>-->
<!--                <default-field title="OutQueue"><display/></default-field>-->
<!--            </field>-->
            <field name="find">
<!--                <header-field title="Find"><submit/></header-field>-->
                <default-field title=""><link url="deleteNetworkPrinter" text="Delete"/></default-field>
            </field>
        </form-list>
    </widgets>
</screen>
